---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import AnnouncementBar from "@components/AnnouncementBar.astro";
import FloatingActions from "@components/FloatingActions.astro";
import Lightbox from "@components/Lightbox.astro";
import { SOCIAL_LINKS, WHATSAPP_URL } from "@lib/constants";
import "@src/globals.css";

interface Props {
  title: string;
  description?: string;
  /** Path under public/ used for social share previews (WhatsApp, Instagram bio link, etc). */
  image?: string;
}

const {
  title,
  description = "TM Cositas — Decoraciones y eventos únicos para hacer de cada celebración un momento inolvidable.",
  image = "/image/image5.jpg",
} = Astro.props;

const pageTitle = title.includes("TM Cositas") ? title : `${title} | TM Cositas`;
const ogImageUrl = new URL(image, Astro.url);

// LocalBusiness structured data — helps Google understand and surface TM
// Cositas for local searches ("decoración de fiestas Lima"). Only confirmed
// facts from PRODUCT.md go here (no invented street address or price range).
const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "TM Cositas",
  description: "Decoración temática para cumpleaños, quinceañeros, bautizos, baby showers y graduaciones en Lima Metropolitana.",
  image: ogImageUrl.toString(),
  url: Astro.url.origin,
  telephone: "+" + WHATSAPP_URL.split("/").pop(),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lima",
    addressRegion: "Lima",
    addressCountry: "PE",
  },
  areaServed: "Lima Metropolitana",
  sameAs: [SOCIAL_LINKS.facebook, SOCIAL_LINKS.instagram, SOCIAL_LINKS.tiktok],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Open Graph / social sharing -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/image/logo-tmcositas.ico" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />

    <!-- Hanken Grotesk — one quiet, distinctive family for display and body alike -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
  </head>
  <body class="font-sans text-gray-900">
    <AnnouncementBar />
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <FloatingActions />
    <Lightbox />

    <script>
      // Fluid spring reveal (Motion) for elements marked [data-reveal], with a
      // per-element stagger via [data-delay] (ms). Skipped for reduced-motion.
      import { animate, inView } from "motion";

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));

      if (prefersReducedMotion || !("IntersectionObserver" in window)) {
        revealTargets.forEach((el) => el.classList.add("is-revealed"));
      } else {
        revealTargets.forEach((el) => {
          inView(
            el,
            () => {
              const delayMs = Number(el.dataset.delay ?? 0);
              animate(
                el,
                { opacity: [0, 1], transform: ["translateY(24px)", "translateY(0px)"] },
                { duration: 0.7, delay: delayMs / 1000, ease: [0.22, 1, 0.36, 1] },
              );
              el.classList.add("is-revealed");
            },
            { margin: "0px 0px -100px 0px" },
          );
        });

        // Safety net: real content must never stay invisible if an element
        // never crosses the viewport threshold (e.g. it's already off-screen
        // in an unusual layout).
        window.setTimeout(() => {
          revealTargets.forEach((el) => el.classList.add("is-revealed"));
        }, 2500);
      }
    </script>
  </body>
</html>
