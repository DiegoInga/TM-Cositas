---
---

<section class="relative flex min-h-[92vh] w-full items-end overflow-hidden">
  <video
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    src="/video-principal.mp4"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  />
  <div class="absolute inset-0 -z-10 bg-black/45"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

  <div class="container relative px-6 pb-16 mx-auto md:px-12 md:pb-20">
    <div class="max-w-xl" data-reveal>
      <p class="mb-4 text-xs font-semibold tracking-[0.2em] text-white/80 uppercase">
        Lima Metropolitana · Decoración a medida
      </p>
      <h1 class="font-display text-4xl font-medium leading-[1.08] text-white sm:text-5xl lg:text-[3.4rem]">
        Cada celebración, un mundo propio.
      </h1>
      <a
        href="/deco"
        class="mt-8 inline-flex items-center rounded-full bg-mauve-500 px-7 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-white transition-colors duration-300 hover:bg-mauve-600"
      >
        Nuestras decoraciones
      </a>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-6 flex justify-center text-white/70 scroll-hint" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
    </svg>
  </div>

  <style>
    @keyframes scroll-hint {
      0%, 100% { transform: translateY(0); opacity: 0.6; }
      50% { transform: translateY(6px); opacity: 1; }
    }
    .scroll-hint {
      animation: scroll-hint 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .scroll-hint { animation: none; }
    }
  </style>

</section>
