---
import { Image } from "astro:assets";
---

<section class="relative py-20 overflow-hidden bg-white md:py-28">
  <div class="container relative grid items-center grid-cols-1 gap-8 px-6 mx-auto md:grid-cols-3 md:px-12">
    <Image
      src="/image/image1.jpeg"
      alt="Detalle de decoración temática de Harry Potter"
      width={480}
      height={480}
      class="hidden aspect-square w-full rounded-sm object-cover shadow-sm md:block"
      data-reveal
    />

    <div class="text-center" data-reveal data-delay="100">
      <p class="text-xs font-semibold tracking-[0.2em] text-mauve-600 uppercase">Nuestra idea</p>
      <h2 class="mt-3 font-display text-3xl font-medium leading-tight text-gray-900 sm:text-4xl">
        No vendemos globos. Creamos un mundo.
      </h2>
      <p class="max-w-sm mx-auto mt-4 text-gray-600">
        Un solo evento, un solo tema, hecho a la medida del homenajeado.
      </p>
    </div>

    <Image
      src="/image/imagen7.jpg"
      alt="Detalle de decoración Oh Baby para baby shower"
      width={480}
      height={480}
      class="hidden aspect-square w-full rounded-sm object-cover shadow-sm md:block"
      data-reveal
      data-delay="200"
    />
  </div>
</section>
