<div id="announcement-bar" class="relative bg-mauve-50 px-4 py-2.5 text-center text-xs font-semibold tracking-wide text-mauve-900">
  <span>Decoración a medida para cada celebración en Lima Metropolitana</span>
  <button
    id="announcement-close"
    class="absolute -translate-y-1/2 right-4 top-1/2 text-mauve-900/60 hover:text-mauve-900"
    aria-label="Cerrar aviso"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<script>
  const bar = document.getElementById("announcement-bar");
  const closeBtn = document.getElementById("announcement-close");

  if (bar && sessionStorage.getItem("announcement-dismissed") === "true") {
    bar.remove();
  }

  closeBtn?.addEventListener("click", () => {
    sessionStorage.setItem("announcement-dismissed", "true");
    bar?.remove();
  });
</script>
